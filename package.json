{
  "name": "screenshot-redactor",
  "version": "0.1.4",
  "description": "Batch screenshot redaction on your device",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop": "pwsh -NoProfile -File scripts/build-desktop.ps1",
    "test:desktop": "node tests/desktop.smoke.mjs",
    "package:win": "npm run desktop && electron-builder --win nsis --x64 --prepackaged release/lightweight/win-unpacked --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "electron-builder": "26.18.0",
    "fflate": "0.8.3"
  },
  "overrides": {
    "app-builder-lib": { "minimatch": "11.0.8" }
  },
  "build": {
    "appId": "io.github.ttt759.screenshotredactor",
    "buildVersion": "0.3.10",
    "productName": "截图脱敏助手",
    "electronVersion": "45.3.1",
    "directories": { "output": "release/lightweight" },
    "win": { "icon": "desktop/icon.ico", "target": "nsis", "executableName": "ScreenshotRedactor", "signExecutable": false },
    "nsis": {
      "artifactName": "screenshot-redactor-setup-${version}-windows-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "createDesktopShortcut": false,
      "shortcutName": "截图脱敏助手"
    }
  }
}
